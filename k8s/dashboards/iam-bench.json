    },
    {
      "type": "row",
      "title": "Load generator sanity",
      "id": 21,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 55
      }
    },
    {
      "type": "timeseries",
      "title": "k6 pod CPU (cores)",
