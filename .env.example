# IAM Performance Tester - Minimal Configuration
#
# Read by the seeder (uv run python scripts/seed_test_data.py) and by
# docker compose. The seeder auto-generates CLIENT_ID, retrieves CLIENT_SECRET
# from the server and writes .env.test for k6.

# IAM provider: "ferriskey" or "keycloak"
IAM_PROVIDER=keycloak

# Server URL (FerrisKey default: http://localhost:3333)
BASE_URL=http://localhost:8080

# Admin credentials (used to seed, and to bootstrap the compose stacks)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Client used to obtain the admin token. Both providers ship a public
# "admin-cli" client in the master realm, so this is normally not needed.
# ADMIN_CLIENT_ID=admin-cli
# ADMIN_CLIENT_SECRET=

# Number of test users to create (k6 picks random users from this pool)
# USER_COUNT=50

# docker compose overrides
# KEYCLOAK_VERSION=26.8.1
# KEYCLOAK_PORT=8080
# FERRISKEY_VERSION=latest
# FERRISKEY_PORT=3333
